<launch>

	<arg name="rviz" default="false" />
    <rosparam command="load" file="$(find lidar_ros)/config/lidar.yaml" />

    <node pkg="lidar_ros" type="lidar_obstacle_detection_node" name="lidar_obstacle_detection_node" output="screen" />
	<node pkg="lidar_ros" type="collision_detection_node" name="collision_detection_node" output="screen" />
	<node pkg="lidar_ros" type="total_distance" name="total_distance" output="screen" />

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find lidar_ros)/rviz_cfg/lidar.rviz" />
	</group>

</launch>
