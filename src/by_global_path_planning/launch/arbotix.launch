<launch>
    <param name="robot_description" command="$(find xacro)/xacro $(find urdf_by)/urdf/xacro/car.xacro" />

   <node pkg="rviz" type="rviz" name="rviz" args="-d $(find urdf_by)/config/latice.rviz" />
    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"  />
 

<node name="arbotix" pkg="arbotix_python" type="arbotix_driver" >
     <rosparam file="$(find urdf_by)/config/control.yaml" command="load" />
     <param name="sim" value="true" />
</node>

    <node pkg="can_pkg" type="mycan_pub" name="mycan_pub"  output="screen"/>
    <node pkg="by_global_path_planning" type="djstl" name="djstl"  output="screen"/>
    <node pkg="by_pure_pursuit" type="pure_pursuit" name="pure_pursuit"  output="screen"/>
    <node pkg="by_pure_pursuit" type="map_control" name="map_control"  output="screen"/>

  <!-- <node pkg="by_global_path_planning" type="djstl" name="djstl"  output="screen"/>
    <node pkg="can_pkg" type="mycan_pub" name="mycan_pub"  output="screen"/> -->
</launch>