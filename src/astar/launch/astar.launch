<!-- -*- mode: XML -*- -->
<launch>

    ################ map server ################
    <node pkg="map_server" name="map_server" type="map_server" args="$(find astar)/maps/map_1130.yaml"/>

    ################ start astar node ################
    <node pkg="astar" type="astar" name="astar" output="screen">
        <param name="Euclidean" value="true"/>
        <param name="OccupyThresh" value="-1"/>
        <param name="InflateRadius" value="0.3"/>
        <param name="rate" value="10"/>
    </node>

    <!-- 将odom和map关联-->
    <node pkg="tf2_ros" type="static_transform_publisher" name="son1" args="0 0 0 0 0 0 /map /odom" output="screen" />
    
    ################ start rviz ################
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find astar)/rviz/astar.rviz"/> -->

</launch>
